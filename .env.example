AUTH_SECRET=
# Required for `next start` on localhost; Vercel sets it automatically
AUTH_TRUST_HOST=true

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB connection string, e.g. from MongoDB Atlas
MONGODB_URI=

# Lowest log level to print: debug, info (default), warn or error
LOG_LEVEL=info

# Optional: where lib/api.ts sends requests. Defaults to this same server
# (http://localhost:<port>/api); set it only if the API runs elsewhere.
# API_BASE_URL=https://example.com/api

# Groq API key for the AI answer route (/api/ai/answers),
# from https://console.groq.com/keys
GROQ_API_KEY=

# RapidAPI key for the JSearch job listings on /jobs. Subscribe to JSearch
# (the free Basic plan is enough) at https://rapidapi.com and copy the key.
# Server-only: don't prefix it with NEXT_PUBLIC_. Without it /jobs shows a
# message instead of listings.
RAPID_API_KEY=
